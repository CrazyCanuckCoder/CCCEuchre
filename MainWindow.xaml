<Window
    x:Class="Euchre.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:Logic="clr-namespace:Euchre.UILogic.Classes"
    xmlns:UserControls="clr-namespace:Euchre.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Euchre"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="Euchre"
    Width="1240"
    Height="950"
    MinWidth="1240"
    MinHeight="950"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">

    <Window.Resources>
        <Style TargetType="Border">
            <Setter Property="BorderBrush" Value="Black" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Background" Value="AliceBlue" />
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">

            <!--  Standard Menu  -->

            <Menu
                x:Name="menuMain"
                Padding="0,2"
                IsMainMenu="True"
                Visibility="{Binding StandardMenuVisibility}">

                <!--  File Menu  -->

                <MenuItem x:Name="menuFile" Header="_File">
                    <MenuItem
                        x:Name="menuNewGame"
                        Click="MenuNewGame_Click"
                        Header="_New Game...">
                        <MenuItem.Icon>
                            <Image Source="/images/icons/Playing-Cards-16.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuContinue"
                        Click="MenuContinue_Click"
                        Header="_Continue"
                        Visibility="{Binding ContinueMenuVisibility, UpdateSourceTrigger=PropertyChanged}">
                        <MenuItem.Icon>
                            <Image Source="/images/icons/Cards-Play-16.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        x:Name="menuExit"
                        Click="MenuExit_Click"
                        Header="E_xit">
                        <MenuItem.Icon>
                            <Image Source="/images/icons/Exit-16.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <!--  Test Menu, in Debug only  -->

                <MenuItem
                    x:Name="menuTest"
                    Header="T_est"
                    Visibility="{x:Static Logic:DebugVisibility.DebugOnly}">
                    <MenuItem
                        x:Name="menuChooseTrump"
                        Click="menuChooseTrump_Click"
                        Header="Choose Trump" />
                    <MenuItem
                        x:Name="menuChooseCard"
                        Click="menuChooseCard_Click"
                        Header="Choose Card" />
                    <MenuItem
                        x:Name="menuChooseCards"
                        Click="menuChooseCards_Click"
                        Header="Choose Cards For Players" />
                </MenuItem>

                <!--  Tools Menu  -->

                <MenuItem x:Name="menuTools" Header="_Tools">
                    <MenuItem
                        x:Name="menuOptions"
                        Click="MenuToolsOptions_Click"
                        Header="_Options">
                        <MenuItem.Icon>
                            <Image Source="/images/icons/Settings-01-16.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>

                <!--  Help Menu  -->

                <MenuItem x:Name="menuHelp" Header="_Help">
                    <MenuItem
                        x:Name="menuHelpAbout"
                        Click="MenuHelpAbout_Click"
                        Header="_About Euchre">
                        <MenuItem.Icon>
                            <Image Source="/images/icons/Help-16.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </MenuItem>
            </Menu>

            <!--  Icon Based Menu  -->

            <Grid Visibility="{Binding IconMenuVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="560" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="10" />
                    <RowDefinition Height="130" />
                    <RowDefinition Height="30" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="0"
                    Orientation="Horizontal">

                    <!--  New Game  -->

                    <Button
                        Margin="10,0,0,0"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MenuNewGame_Click">
                        <StackPanel>
                            <Image
                                Width="120"
                                Source="/images/icons/Playing-Cards-128.png"
                                ToolTip="Starts a new game of Euchre." />

                            <AccessText
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Text="_New Game" />
                        </StackPanel>
                    </Button>

                    <!--  Continue Game  -->

                    <Button
                        Margin="10,0,0,0"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MenuContinue_Click"
                        Visibility="{Binding ContinueMenuVisibility, UpdateSourceTrigger=PropertyChanged}">
                        <StackPanel>
                            <Image
                                Width="120"
                                Source="/images/icons/Cards-Play-128.png"
                                ToolTip="Continues the previously played game." />

                            <AccessText
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Text="_Continue" />
                        </StackPanel>
                    </Button>

                    <!--  Options  -->

                    <Button
                        Margin="10,0,0,0"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MenuToolsOptions_Click">
                        <StackPanel>
                            <Image
                                Width="120"
                                Source="/images/icons/Settings-01-128.png"
                                ToolTip="Modifies the settings for the game." />
                            <AccessText
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Text="_Options" />
                        </StackPanel>
                    </Button>

                    <!--  About  -->

                    <Button
                        Margin="10,0,0,0"
                        Padding="2"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="MenuHelpAbout_Click">
                        <StackPanel>
                            <Image
                                Width="120"
                                Source="/images/icons/Help-128.png"
                                ToolTip="Displays information about the Euchre game." />
                            <AccessText
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                Text="_About Euchre" />
                        </StackPanel>
                    </Button>
                </StackPanel>

                <!--  Exit  -->

                <Button
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="2"
                    Padding="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="MenuExit_Click">
                    <StackPanel>
                        <Image
                            Width="120"
                            Source="/images/icons/Exit-128.png"
                            ToolTip="Exits the game." />
                        <AccessText
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Text="E_xit" />
                    </StackPanel>
                </Button>
            </Grid>
        </StackPanel>

        <!--  Game Board  -->

        <Border
            BorderThickness="0"
            DockPanel.Dock="Bottom"
            Visibility="{Binding GameBoardVisibility}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="10" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="5" />
                    <RowDefinition />
                    <RowDefinition Height="5" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="10" />
                </Grid.RowDefinitions>

                <!--  Current Scores  -->
                <!--  Had to set the width for this control to get it to render properly.  -->

                <UserControls:CurrentScoreUserControl
                    x:Name="CurrentPlayersScoresUserControl"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="312" />

                <!--  Player 3 Controls  -->

                <Border
                    Grid.Row="1"
                    Grid.Column="3"
                    Background="#FFF7F0">
                    <StackPanel>
                        <UserControls:HorizontalPlayerDisplayUserControl
                            x:Name="Player3DisplayUserControl"
                            Height="110"
                            Margin="5,5,5,0" />
                        <UserControls:CardDisplayUserControl
                            x:Name="Player3CardDisplayUserControl"
                            Height="140"
                            Margin="5,0,5,5" />
                    </StackPanel>
                </Border>

                <!--  Current Round Information Control  -->

                <UserControls:CurrentRoundInfoUserControl
                    x:Name="CurrentRoundInfoUserControl"
                    Grid.Row="1"
                    Grid.Column="5" />

                <!--  Player 2 Controls  -->

                <Border
                    Grid.Row="3"
                    Grid.Column="1"
                    Background="#FFF7F0">
                    <StackPanel Orientation="Horizontal">
                        <UserControls:VerticalPlayerDisplayUserControl
                            x:Name="Player2DisplayUserControl"
                            Width="120"
                            Margin="5" />
                        <UserControls:VerticalCardDisplayUserControl
                            x:Name="Player2CardDisplayUserControl"
                            Width="150"
                            Margin="5" />
                    </StackPanel>
                </Border>

                <!--  Center Display Area  -->

                <Grid Grid.Row="3" Grid.Column="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                        <RowDefinition />
                    </Grid.RowDefinitions>

                    <!--  Player 3 Dealt Cards Display  -->

                    <UserControls:CardDisplayUserControl
                        x:Name="Player3DealtCardsDisplayUserControl"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Height="140"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Visibility="{Binding Player3DealtCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />


                    <!--  Player 3 Played Cards Display  -->

                    <UserControls:CardDisplayUserControl
                        x:Name="Player3PlayedCardsDisplayUserControl"
                        Grid.Row="0"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Height="140"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Visibility="{Binding Player3PlayedCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  Player 3 Text Display Box  -->

                    <Border
                        Grid.Row="0"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="200"
                        Height="60"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Visibility="{Binding Player3TextVisibility}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding Player3Text}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Player 2 Dealt Cards Display  -->

                    <UserControls:VerticalCardDisplayUserControl
                        x:Name="Player2DealtCardsDisplayUserControl"
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="0"
                        Width="150"
                        VerticalAlignment="Center"
                        Visibility="{Binding Player2DealtCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  Player 2 Played Cards Display  -->

                    <UserControls:CardDisplayUserControl
                        x:Name="Player2PlayedCardsDisplayUserControl"
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="0"
                        Height="140"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Visibility="{Binding Player2PlayedCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  Player 2 Text Display Box  -->

                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="0"
                        Height="60"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Visibility="{Binding Player2TextVisibility}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding Player2Text}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Player 4 Dealt Cards Display  -->

                    <UserControls:VerticalCardDisplayUserControl
                        x:Name="Player4DealtCardsDisplayUserControl"
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="3"
                        Width="150"
                        VerticalAlignment="Center"
                        Visibility="{Binding Player4DealtCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  Player 4 Played Cards Display  -->

                    <UserControls:CardDisplayUserControl
                        x:Name="Player4PlayedCardsDisplayUserControl"
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="3"
                        Height="140"
                        VerticalAlignment="Center"
                        Visibility="{Binding Player4PlayedCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  Player 4 Text Display Box  -->

                    <Border
                        Grid.Row="0"
                        Grid.RowSpan="4"
                        Grid.Column="3"
                        Height="60"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Visibility="{Binding Player4TextVisibility}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding Player4Text}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Player 1 Dealt Cards Display  -->

                    <UserControls:CardDisplayUserControl
                        x:Name="Player1DealtCardsDisplayUserControl"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Height="140"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding Player1DealtCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  Player 1 Played Cards Display  -->

                    <UserControls:CardDisplayUserControl
                        x:Name="Player1PlayedCardsDisplayUserControl"
                        Grid.Row="2"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Height="140"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Visibility="{Binding Player1PlayedCardsDisplayUserControlVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />

                    <!--  Player 1 Text Display Box  -->

                    <Border
                        Grid.Row="3"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Width="200"
                        Height="60"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Visibility="{Binding Player1TextVisibility}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding Player1Text}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>

                    <!--  Center Information Box  -->

                    <Border
                        Grid.Row="1"
                        Grid.RowSpan="2"
                        Grid.Column="1"
                        Grid.ColumnSpan="2"
                        Margin="10"
                        Background="White"
                        BorderBrush="Black"
                        BorderThickness="1"
                        Visibility="{Binding GameInformationVisibility, UpdateSourceTrigger=PropertyChanged}">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            Text="{Binding GameInformation, UpdateSourceTrigger=PropertyChanged}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </Border>

                </Grid>

                <!--  Player 4 Controls  -->

                <Border
                    Grid.Row="3"
                    Grid.Column="5"
                    Background="#FFF7F0">
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <UserControls:VerticalCardDisplayUserControl
                            x:Name="Player4CardDisplayUserControl"
                            Width="150"
                            Margin="5" />
                        <UserControls:VerticalPlayerDisplayUserControl
                            x:Name="Player4DisplayUserControl"
                            Width="120"
                            Margin="5" />
                    </StackPanel>
                </Border>

                <!--  Trump Display Control  -->

                <UserControls:TrumpDisplayUserControl
                    x:Name="TrumpDisplayUserControl"
                    Grid.Row="5"
                    Grid.Column="1" />

                <!--  Player 1 Controls  -->

                <Border
                    Grid.Row="5"
                    Grid.Column="3"
                    Background="#FFF7F0">
                    <StackPanel>
                        <UserControls:CardDisplayUserControl
                            x:Name="Player1CardDisplayUserControl"
                            Height="140"
                            Margin="5,5,5,0" />
                        <UserControls:HorizontalPlayerDisplayUserControl
                            x:Name="Player1DisplayUserControl"
                            Height="110"
                            Margin="5,0,5,5" />
                    </StackPanel>
                </Border>

                <!--  Previous Tricks Control  -->

                <UserControls:PreviousTricksUserControl
                    x:Name="PreviousTricksUserControl"
                    Grid.Row="5"
                    Grid.Column="5" />

            </Grid>
        </Border>
    </DockPanel>
</Window>
