<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package Name="Euchre"
		   Language="1033"
		   Version="1.0.0.0"
		   Manufacturer="CrazyCanuckCoder"
		   UpgradeCode="87654321-4321-4321-4321-210987654321"
		   Compressed="yes">

	<SummaryInformation Keywords="Euchre, Card Game" Description="Windows Installer for Euchre Application" />

	<Media Id="1" Cabinet="Euchre.cab" EmbedCab="yes" />

	<MajorUpgrade DowngradeErrorMessage="A newer version of Euchre is already installed." />

	<!-- Install to Program Files -->
	<StandardDirectory Id="ProgramFiles64Folder">
	  <Directory Id="INSTALLFOLDER" Name="Euchre" />
	</StandardDirectory>

	<!-- Start Menu -->
	<StandardDirectory Id="ProgramMenuFolder">
	  <Directory Id="ApplicationProgramsFolder" Name="Euchre" />
	</StandardDirectory>

	<!-- Desktop -->
	<StandardDirectory Id="DesktopFolder" />

	<!-- Main Feature -->
	<Feature Id="ProductFeature" Title="Euchre" Level="1" Display="expand" ConfigurableDirectory="INSTALLFOLDER">
	  <ComponentRef Id="MainExecutable" />
	  <ComponentRef Id="RuntimeComponents" />
	  <ComponentRef Id="ProgramMenuShortcut" />
	  <ComponentRef Id="DesktopShortcut" />
	</Feature>

	<!-- Main Application Files -->
	<DirectoryRef Id="INSTALLFOLDER">
	  <Component Id="MainExecutable" Guid="11111111-1111-1111-1111-111111111111" Bitness="always64">
		<File Source="bin\Release\net10.0-windows7.0\Euchre.exe" KeyPath="yes" />
		<File Source="bin\Release\net10.0-windows7.0\Euchre.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Euchre.runtimeconfig.json" />
		<File Source="bin\Release\net10.0-windows7.0\Euchre.deps.json" />
		<File Source="bin\Release\net10.0-windows7.0\Euchre.Logic.dll" />
		<File Source="bin\Release\net10.0-windows7.0\About.txt" />
		<File Source="bin\Release\net10.0-windows7.0\LICENSE.txt" />
		<File Source="bin\Release\net10.0-windows7.0\HowToPlay.md" />

		<!-- Registry entries for Add/Remove Programs -->
		<RegistryKey Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\[ProductCode]" ForceCreateOnInstall="yes">
		  <RegistryValue Type="string" Name="DisplayName" Value="Euchre" />
		  <RegistryValue Type="string" Name="DisplayVersion" Value="1.0.0.0" />
		  <RegistryValue Type="string" Name="Publisher" Value="CrazyCanuckCoder" />
		  <RegistryValue Type="string" Name="UninstallString" Value="[System64Folder]msiexec.exe /x [ProductCode]" />
		  <RegistryValue Type="integer" Name="NoModify" Value="1" />
		  <RegistryValue Type="integer" Name="NoRepair" Value="1" />
		</RegistryKey>
	  </Component>

	  <!-- Runtime and Dependencies -->
	  <Component Id="RuntimeComponents" Guid="55555555-5555-5555-5555-555555555555" Bitness="always64">
		<File Source="bin\Release\net10.0-windows7.0\CrazyCanuckCoder.Library.Common.dll" />
		<File Source="bin\Release\net10.0-windows7.0\CrazyCanuckCoder.Library.WPF.dll" />
		<File Source="bin\Release\net10.0-windows7.0\CrazyCanuckCoder.Library.WPFControls.dll" />
		<File Source="bin\Release\net10.0-windows7.0\CrazyCanuckCoder.Library.Data.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Markdown.Xaml.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Newtonsoft.Json.dll" />
		<File Source="bin\Release\net10.0-windows7.0\log4net.dll" />
		<File Source="bin\Release\net10.0-windows7.0\log4net.config" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.Abstractions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.Binder.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.CommandLine.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.EnvironmentVariables.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.FileExtensions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.Json.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Configuration.UserSecrets.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.DependencyInjection.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Diagnostics.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Diagnostics.Abstractions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.FileProviders.Abstractions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.FileProviders.Physical.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.FileSystemGlobbing.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Hosting.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Hosting.Abstractions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Logging.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Logging.Abstractions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Logging.Configuration.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Logging.Console.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Logging.Debug.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Logging.EventLog.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Logging.EventSource.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Options.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Options.ConfigurationExtensions.dll" />
		<File Source="bin\Release\net10.0-windows7.0\Microsoft.Extensions.Primitives.dll" />
	  </Component>
	</DirectoryRef>

	<!-- Program Menu Shortcut -->
	<DirectoryRef Id="ApplicationProgramsFolder">
	  <Component Id="ProgramMenuShortcut" Guid="33333333-3333-3333-3333-333333333333" Bitness="always64">
		<Shortcut Id="ApplicationProgramsMenuShortcut"
				  Name="Euchre"
				  Target="[INSTALLFOLDER]Euchre.exe"
				  WorkingDirectory="INSTALLFOLDER" />
		<RemoveFolder Id="ApplicationProgramsFolder" On="uninstall" />
		<RegistryValue Root="HKCU"
					   Key="Software\CrazyCanuckCoder\Euchre"
					   Type="string"
					   Value="installed"
					   KeyPath="yes" />
	  </Component>
	</DirectoryRef>

	<!-- Desktop Shortcut -->
	<StandardDirectory Id="DesktopFolder">
	  <Component Id="DesktopShortcut" Guid="44444444-4444-4444-4444-444444444444" Bitness="always64">
		<Shortcut Id="DesktopApplicationShortcut"
				  Name="Euchre"
				  Target="[INSTALLFOLDER]Euchre.exe"
				  WorkingDirectory="INSTALLFOLDER" />
		<RegistryValue Root="HKCU"
					   Key="Software\CrazyCanuckCoder\Euchre\Desktop"
					   Type="string"
					   Value="installed"
					   KeyPath="yes" />
	  </Component>
	</StandardDirectory>

  </Package>

</Wix>
