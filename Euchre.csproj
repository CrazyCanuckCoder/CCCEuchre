<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>images\icons\Euchre.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove=".github\**" />
    <Compile Remove="Docs\**" />
    <Compile Remove="Euchre.Console\**" />
    <Compile Remove="Euchre.Logic\**" />
    <Compile Remove="Euchre.Setup\**" />
    <Compile Remove="Euchre.Tests\**" />
    <Compile Remove="Euchre.WAP\**" />
    <EmbeddedResource Remove=".github\**" />
    <EmbeddedResource Remove="Docs\**" />
    <EmbeddedResource Remove="Euchre.Console\**" />
    <EmbeddedResource Remove="Euchre.Logic\**" />
    <EmbeddedResource Remove="Euchre.Setup\**" />
    <EmbeddedResource Remove="Euchre.Tests\**" />
    <EmbeddedResource Remove="Euchre.WAP\**" />
    <None Remove=".github\**" />
    <None Remove="Docs\**" />
    <None Remove="Euchre.Console\**" />
    <None Remove="Euchre.Logic\**" />
    <None Remove="Euchre.Setup\**" />
    <None Remove="Euchre.Tests\**" />
    <None Remove="Euchre.WAP\**" />
    <Page Remove=".github\**" />
    <Page Remove="Docs\**" />
    <Page Remove="Euchre.Console\**" />
    <Page Remove="Euchre.Logic\**" />
    <Page Remove="Euchre.Setup\**" />
    <Page Remove="Euchre.Tests\**" />
    <Page Remove="Euchre.WAP\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="About.md" />
    <None Remove="COMPLETION_CHECKLIST.md" />
    <None Remove="HowToPlay.md" />
    <None Remove="INSTALLER_PLAN.md" />
    <None Remove="INSTALLER_SUMMARY.md" />
    <None Remove="LICENSE.txt" />
    <None Remove="QUICK_REFERENCE.md" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="About.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="HowToPlay.md">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="LICENSE.txt">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="Euchre.Logic\Euchre.Logic.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="CrazyCanuckCoder.Library.Common">
      <HintPath>..\CrazyCanuckCoder\Library.Common\bin\Debug\net8.0-windows\CrazyCanuckCoder.Library.Common.dll</HintPath>
    </Reference>
    <Reference Include="CrazyCanuckCoder.Library.WPF">
      <HintPath>..\CrazyCanuckCoder\Library.WPF\bin\Debug\net8.0-windows\CrazyCanuckCoder.Library.WPF.dll</HintPath>
    </Reference>
    <Reference Include="CrazyCanuckCoder.Library.WPFControls">
      <HintPath>..\CrazyCanuckCoder\Library.WPFControls\bin\Debug\net8.0-windows\CrazyCanuckCoder.Library.WPFControls.dll</HintPath>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="MarkdownWPF" Version="1.1.4" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
  </ItemGroup>

</Project>
