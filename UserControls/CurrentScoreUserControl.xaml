<UserControl
    x:Class="Euchre.UserControls.CurrentScoreUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:WPFControls="clr-namespace:CrazyCanuckCoder.Library.WPFControls;assembly=CrazyCanuckCoder.Library.WPFControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Euchre.UserControls"
    xmlns:logic="clr-namespace:Euchre.UILogic"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="250"
    d:DesignWidth="230"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition />
            <ColumnDefinition Width="20" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="30" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <!--  Title Label  -->

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Background="#FFF7F0"
            BorderBrush="Black"
            BorderThickness="1">
            <TextBlock
                Margin="5,0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontSize="16"
                Text="Current Scores" />
        </Border>

        <!--  Score Data  -->

        <Border
            Grid.Row="1"
            Grid.Column="0"
            Grid.ColumnSpan="3"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1,0,1,1">
            <Grid Margin="20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                    <RowDefinition />
                    <RowDefinition Height="40" />
                    <RowDefinition Height="40" />
                </Grid.RowDefinitions>

                <!--  Team 1 Score Controls  -->

                <Label
                    Grid.Row="0"
                    Grid.Column="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Content="{Binding Team1Names}"
                    FontSize="16" />
                <Border
                    Grid.Row="1"
                    Grid.Column="0"
                    BorderBrush="Black"
                    BorderThickness="1,0,1,1">
                    <WPFControls:LabelledProgressBarUserControl
                        x:Name="labelledProgressBarUserControlTeam1"
                        Background="White"
                        MaximumValue="10"
                        MinimumValue="0"
                        ProgressBarColour="{x:Static logic:UIConstants.Team1Colour}" />
                </Border>

                <!--  Team 2 Score Controls  -->

                <Label
                    Grid.Row="3"
                    Grid.Column="0"
                    HorizontalContentAlignment="Center"
                    VerticalContentAlignment="Center"
                    BorderBrush="Black"
                    BorderThickness="1"
                    Content="{Binding Team2Names}"
                    FontSize="16" />
                <Border
                    Grid.Row="4"
                    Grid.Column="0"
                    BorderBrush="Black"
                    BorderThickness="1,0,1,1">
                    <WPFControls:LabelledProgressBarUserControl
                        x:Name="labelledProgressBarUserControlTeam2"
                        Background="White"
                        MaximumValue="10"
                        MinimumValue="0"
                        ProgressBarColour="{x:Static logic:UIConstants.Team2Colour}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
