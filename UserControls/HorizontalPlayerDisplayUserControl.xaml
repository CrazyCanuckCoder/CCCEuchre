<UserControl
    x:Class="Euchre.UserControls.HorizontalPlayerDisplayUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Euchre.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    d:DesignHeight="120"
    d:DesignWidth="710"
    Background="#FFF7F0"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Label">
            <Style.Setters>
                <Setter Property="BorderBrush" Value="Black" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="Background" Value="White" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Width" Value="160" />
            </Style.Setters>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="160" />
            <ColumnDefinition />
            <ColumnDefinition Width="160" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Grid.Column="0"
            Orientation="Horizontal">

            <!--  Player Name  -->

            <Label
                Margin="0,0,5,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                BorderThickness="1"
                Content="{Binding ActivePlayer.Player.Name, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
                FontSize="16" />

            <!--  Dealer Indicator Image  -->

            <Image
                Width="30"
                Height="30"
                Margin="-44,0,0,0"
                Source="/Euchre;component/images/icons/dealer.png"
                Stretch="Fill"
                Visibility="{Binding DealerIconVisibility, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}" />
        </StackPanel>

        <!--  Avatar Image  -->

        <local:AvatarUserControl
            Grid.Row="0"
            Grid.Column="1"
            Width="100"
            Height="100"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            AvatarNumber="{Binding ActivePlayer.AvatarNumber, RelativeSource={RelativeSource AncestorType=UserControl}, UpdateSourceTrigger=PropertyChanged}"
            HasBorder="False" />

        <!--  Number of Tricks  -->

        <Border
            Grid.Row="0"
            Grid.Column="2"
            Height="38"
            VerticalAlignment="Center"
            Background="White"
            BorderBrush="Black"
            BorderThickness="1">

            <!--  Icons when the player is the bidder or bidder's partner.  -->

            <Grid >
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="10" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="4" />
                    <RowDefinition Height="28" />
                    <RowDefinition Height="6" />
                </Grid.RowDefinitions>

                <Image
                    Grid.Row="1"
                    Grid.Column="1"
                    Source="/Euchre;component/images/icons/green.png"
                    ToolTip="The number of tricks won by the player."
                    Visibility="{Binding TrickIconsVisibility[4]}" />
                <Image
                    Grid.Row="1"
                    Grid.Column="2"
                    Source="/Euchre;component/images/icons/green.png"
                    ToolTip="The number of tricks won by the player."
                    Visibility="{Binding TrickIconsVisibility[3]}" />
                <Image
                    Grid.Row="1"
                    Grid.Column="3"
                    Source="/Euchre;component/images/icons/green.png"
                    ToolTip="The number of tricks won by the player."
                    Visibility="{Binding TrickIconsVisibility[2]}" />
                <Image
                    Grid.Row="1"
                    Grid.Column="4"
                    Source="/Euchre;component/images/icons/green.png"
                    ToolTip="The number of tricks won by the player."
                    Visibility="{Binding TrickIconsVisibility[1]}" />
                <Image
                    Grid.Row="1"
                    Grid.Column="5"
                    Source="/Euchre;component/images/icons/green.png"
                    ToolTip="The number of tricks won by the player."
                    Visibility="{Binding TrickIconsVisibility[0]}" />
            </Grid>
        </Border>
    </Grid>
</UserControl>
