<UserControl
    x:Class="Euchre.UserControls.CurrentRoundInfoUserControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Euchre.UserControls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    MinWidth="230"
    d:DesignHeight="291"
    d:DesignWidth="281"
    mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="TextLabel" TargetType="Label">
            <Style.Setters>
                <Setter Property="BorderBrush" Value="Black" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="Background" Value="White" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
            </Style.Setters>
        </Style>
    </UserControl.Resources>

    <Border
        Background="#FFF7F0"
        BorderBrush="Black"
        BorderThickness="1">
        <Grid Margin="20">

            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition Width="30" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="30" />
                <RowDefinition Height="10" />
                <RowDefinition Height="30" />
                <RowDefinition Height="5" />
                <RowDefinition />
                <RowDefinition Height="30" />
                <RowDefinition Height="5" />
                <RowDefinition />
            </Grid.RowDefinitions>


            <!--  Bidding Information Label  -->

            <Label
                Grid.Row="0"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Content="{Binding BidInfo}"
                FontSize="16"
                Style="{DynamicResource TextLabel}" />

            <!--  Teams Label and First Team Colour  -->

            <Label
                Grid.Row="2"
                Grid.Column="0"
                Content="Teams" />
            <Label
                Grid.Row="2"
                Grid.Column="2"
                Background="{Binding Team1Colour}" />

            <!--  Team 1 List  -->

            <ListBox
                Grid.Row="4"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                ItemsSource="{Binding Team1List}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Height="26"
                            VerticalContentAlignment="Center"
                            Content="{Binding Name}"
                            FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!--  Second Team Colour  -->

            <Label
                Grid.Row="5"
                Grid.Column="2"
                Background="{Binding Team2Colour}" />

            <!--  Team 1 List  -->

            <ListBox
                Grid.Row="7"
                Grid.Column="0"
                Grid.ColumnSpan="3"
                ItemsSource="{Binding Team2List}">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="{x:Type ListBoxItem}">
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>

                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Label
                            Height="26"
                            VerticalContentAlignment="Center"
                            Content="{Binding Name}"
                            FontSize="13" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

        </Grid>
    </Border>
</UserControl>
