<Window
    x:Class="Euchre.Windows.NewGameWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:UserControls="clr-namespace:Euchre.UserControls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Euchre.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="New Game"
    Width="450"
    Height="775"
    FontSize="{DynamicResource GlobalFontSize}"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="20" />
            <ColumnDefinition />
            <ColumnDefinition Width="20" />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="20" />
            <RowDefinition Height="140" />
            <RowDefinition Height="30" />
            <RowDefinition Height="30" />
            <RowDefinition />
            <RowDefinition Height="30" />
            <RowDefinition Height="45" />
            <RowDefinition Height="20" />
        </Grid.RowDefinitions>

        <!--  User Entry  -->

        <Border
            Grid.Row="1"
            Grid.Column="1"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="0.5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="20" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="20" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="50" />
                    <RowDefinition Height="20" />
                </Grid.RowDefinitions>

                <Label
                    Grid.Row="1"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Content="Enter your name:" />
                <TextBox
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="5,10,5,0"
                    Padding="5"
                    VerticalContentAlignment="Center"
                    Text="{Binding PlayerName, Mode=TwoWay}" />
                <Button
                    Grid.Row="1"
                    Grid.RowSpan="2"
                    Grid.Column="3"
                    Background="White"
                    BorderBrush="Black"
                    BorderThickness="0.5"
                    Click="ChooseAvatarButton_Click">
                    <StackPanel>
                        <TextBlock
                            Text="Click here to set your avatar."
                            TextAlignment="Center"
                            TextWrapping="Wrap"
                            Visibility="{Binding ClickHereLabelVisibility}" />
                        <UserControls:AvatarUserControl
                            x:Name="avatarUserControl"
                            Margin="-1"
                            Visibility="{Binding UserAvatarVisibility, RelativeSource={RelativeSource AncestorType=Window}}" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <!--  Automated Players Label  -->

        <Label
            Grid.Row="3"
            Grid.Column="1"
            Content="Choose Automated Players" />

        <!--  Automated Players List  -->

        <Border
            Grid.Row="4"
            Grid.Column="1"
            Background="#FFF7F0"
            BorderBrush="Black"
            BorderThickness="0.5">
            <StackPanel>

                <!--  Player 2  -->

                <Border BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Player 2:" />
                        <ComboBox
                            x:Name="comboBoxPlayer2"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,10,5,0"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            DisplayMemberPath="PlayerName"
                            ItemsSource="{Binding AvailablePlayerAvatars}"
                            SelectedItem="{Binding SelectedPlayerAvatars[0]}" />
                        <UserControls:AvatarUserControl
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            AvatarNumber="{Binding SelectedPlayerAvatars[0].AvatarNumber, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="White" />
                    </Grid>
                </Border>

                <!--  Player 3  -->

                <Border BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Player 3:" />
                        <ComboBox
                            x:Name="comboBoxPlayer3"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,10,5,0"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            DisplayMemberPath="PlayerName"
                            ItemsSource="{Binding AvailablePlayerAvatars, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectedItem="{Binding SelectedPlayerAvatars[1]}" />
                        <UserControls:AvatarUserControl
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            AvatarNumber="{Binding SelectedPlayerAvatars[1].AvatarNumber, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="White" />
                    </Grid>
                </Border>

                <!--  Player 4  -->

                <Border BorderThickness="0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="100" />
                            <ColumnDefinition Width="20" />
                        </Grid.ColumnDefinitions>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="20" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="50" />
                            <RowDefinition Height="20" />
                        </Grid.RowDefinitions>

                        <Label
                            Grid.Row="1"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            Content="Player 4:" />
                        <ComboBox
                            x:Name="comboBoxPlayer4"
                            Grid.Row="2"
                            Grid.Column="1"
                            Margin="5,10,5,0"
                            VerticalContentAlignment="Center"
                            BorderThickness="0"
                            DisplayMemberPath="PlayerName"
                            ItemsSource="{Binding AvailablePlayerAvatars, RelativeSource={RelativeSource AncestorType=Window}}"
                            SelectedItem="{Binding SelectedPlayerAvatars[2]}" />
                        <UserControls:AvatarUserControl
                            Grid.Row="1"
                            Grid.RowSpan="2"
                            Grid.Column="3"
                            AvatarNumber="{Binding SelectedPlayerAvatars[2].AvatarNumber, RelativeSource={RelativeSource AncestorType=Window}}"
                            Background="White" />
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!--  Start Game Button  -->

        <Button
            Grid.Row="6"
            Grid.Column="1"
            HorizontalAlignment="Left"
            Click="ButtonStartGame_Click"
            Content="_Start Game"
            IsDefault="True"
            Style="{DynamicResource SubmitButtonStyle}" />

        <!--  Cancel Button  -->

        <Button
            Grid.Row="6"
            Grid.Column="1"
            HorizontalAlignment="Right"
            Click="ButtonCancel_Click"
            Content="_Cancel"
            IsCancel="True"
            Style="{DynamicResource SubmitButtonStyle}" />
    </Grid>
</Window>