<Window
    x:Class="Euchre.Windows.QuestionWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Euchre.Windows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="{Binding TitleText}"
    Width="500"
    Height="250"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterOwner"
    mc:Ignorable="d">

    <Grid Margin="20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition />
            <ColumnDefinition />
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition Height="30" />
            <RowDefinition Height="45" />
        </Grid.RowDefinitions>

        <!--  Text Display  -->

        <Border
            Grid.Row="0"
            Grid.Column="0"
            Grid.ColumnSpan="2"
            Background="AliceBlue"
            BorderBrush="Black"
            BorderThickness="0.5">
            <Label
                Margin="10"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Content="{Binding DescriptionText}"
                FontSize="14" />
        </Border>

        <!--  Yes Button  -->

        <Button
            Grid.Row="2"
            Grid.Column="0"
            Click="YesButton_Click"
            Content="_Yes"
            IsDefault="True"
            Style="{DynamicResource SubmitButtonStyle}" />

        <!--  No Button  -->

        <Button
            Grid.Row="2"
            Grid.Column="1"
            Click="NoButton_Click"
            Content="_No"
            IsCancel="True"
            Style="{DynamicResource SubmitButtonStyle}" />
    </Grid>
</Window>
